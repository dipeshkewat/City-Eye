# ==========================================
# CityEye Backend Production Environment Configuration
# ==========================================

# PostgreSQL Connection (Neon, Supabase, AWS RDS, or local)
# Pooled connection string recommended for serverless/cloud environments:
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# JWT Security
SECRET_KEY=generate-a-strong-random-key-for-production-cityeye-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (comma-separated list of allowed origins or * for open)
CORS_ORIGINS=*

# Server Port (default: 10000 or 8000)
PORT=10000

